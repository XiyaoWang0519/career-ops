# Copy to .env.local and adjust.

# Absolute path to the career-ops checkout this UI should use
# (defaults to the parent of web/ when unset)
# CAREER_OPS_ROOT=/absolute/path/to/career-ops

# Pin the AI backend so Config doesn't show a picker
# CAREER_OPS_DEFAULT_CLI=codex

# Friend-ready trimmed sidebar
# CAREER_OPS_SIMPLE=1

# Password gate for remote access (leave unset for local-only zero-config)
# WEB_AUTH_PASSWORD=
# WEB_AUTH_SECRET=
